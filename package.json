{
  "name": "farmer-code-builder",
  "version": "0.2.0",
  "description": "Japanese visual block-based code builder for The Farmer Was Replaced",
  "author": "Aresto1126",
  "license": "MIT",
  "main": "desktop/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aresto1126/farmer-code-builder.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "prebuild": "node scripts/prepare.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5178 --strictPort",
    "test": "node --test tests/*.test.js",
    "desktop": "npm run build && electron .",
    "dist:win": "npm test && npm run build && electron-builder --win portable nsis --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir --publish never"
  },
  "devDependencies": {
    "blockly": "12.5.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide": "0.468.0",
    "vite": "^7.2.2"
  }
}
